{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.mjs",
      "**/*.json",
      "!**/dist",
      "!**/.sharrowkin",
      "!**/src-tauri",
      "!**/.svelte-check",
      "!**/src/**/*.svelte",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
