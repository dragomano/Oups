{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oups",
  "identifier": "com.toster.oups",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oups",
        "width": 1000,
        "height": 660,
        "minWidth": 660,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Productivity",
    "publisher": "Bugo",
    "homepage": "https://github.com/dragomano/Oups",
    "copyright": "Copyright (c) 2026 Bugo. MIT license.",
    "shortDescription": "Reminders with recurring schedules, snooze and priorities",
    "longDescription": "Create reminders with popup notifications, flexible recurrence, snooze and four priority levels. Organize reminders in a list or an Eisenhower matrix, import Wise Reminder data and keep everything locally.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
