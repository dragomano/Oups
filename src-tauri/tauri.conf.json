{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oups",
  "identifier": "com.toster.oups",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oups",
        "width": 1000,
        "height": 660,
        "minWidth": 660,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
